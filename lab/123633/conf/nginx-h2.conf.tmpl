# CVE-2026-123633 lab — HTTP/2 + proxy_pass + tiny worker_connections.
#
# Single worker for clean crash attribution; TWO listeners share the same
# worker and thus the same worker_connections slot pool:
#   - 8080/tcp  plain HTTP/1 — the healthcheck + the h1 keepalive fillers
#               (idle keepalive h1 connections are reusable-marked and
#               hold slots; opening them AFTER the h2 partial frame keeps
#               them at the HEAD of the reusable queue, so the h2
#               connection — marked FIRST — stays at the TAIL, which is
#               exactly what ngx_drain_connections() selects first)
#   - 9443/tcp  ssl + http2 on — the CVE surface (separate server block
#               so 8080 never negotiates h2)
#
# worker_connections is deliberately tiny: ngx_get_connection() calls
# ngx_drain_connections() on EVERY allocation, and the drain acts when
# free_connection_n <= connection_n/16 — with WC=32 that is 2. The value
# is substituted at container start from the WC env (entrypoint.sh), so
# the iteration matrix (32/48/64) needs no rebuild.
#
# Slot math at WC=32: 2 listener connections + 1 h2 trigger connection
# + 27 h1 keepalive fillers = 30 used, free = 2 <= 2 -> the trigger
# request's own upstream ngx_get_connection (inside
# ngx_event_connect_peer) fires the drain that selects the h2 connection.
#
# LOGLEVEL (default notice) is substituted by the entrypoint too:
#   notice — WARN "worker_connections are not enough, reusing
#            connections" (the drain marker, once/second), worker death
#            lines, ALERT "http request count is zero"
#   debug  — adds the per-victim "reusing connection" lines, the h2
#            "reusable connection: 1/0" marks and frame state saves:
#            the full drain-dynamics trace (verbose; for analysis runs)
worker_processes  1;
error_log  /dev/stderr __LOGLEVEL__;
pid        /tmp/nginx.pid;

events {
    worker_connections  __WC__;
}

http {
    access_log  /dev/stdout;

    upstream backend {
        server upstream:8080;
    }

    # plain HTTP/1 listener: healthcheck + h1 keepalive fillers
    server {
        listen      8080;

        location = /health {
            return 200 "ok\n";
        }

        location = /stub_status {
            stub_status;
        }

        # BUSY pressure holder for the trigger (poc/123633/trigger.py):
        # one unread GET /slow?ms=N holds two worker slots (client +
        # upstream) and is never reusable-marked, so connection drains
        # cannot touch it — the deterministic slot-pressure instrument.
        location = /slow {
            proxy_pass http://backend/slow;
        }
    }

    # TLS + HTTP/2 listener: the CVE surface
    server {
        listen      9443 ssl;
        http2       on;

        ssl_certificate      /etc/nginx/certs/lab.crt;
        ssl_certificate_key  /etc/nginx/certs/lab.key;
        ssl_protocols        TLSv1.2 TLSv1.3;

        keepalive_timeout  75s;
        keepalive_requests 10000;

        location = /health {
            return 200 "ok\n";
        }

        # Trigger paths (the request whose completion opens the stream
        # and runs proxy_pass -> ngx_event_connect_peer ->
        # ngx_get_connection -> drain):
        location = /proxied {
            proxy_pass http://backend/ok;
        }

        # Instantly-refused upstream inside the nginx container
        # (nothing listens on 127.0.0.1:9) — same connect window, no
        # upstream dependency after it.
        location = /refused {
            proxy_pass http://127.0.0.1:9/;
        }

        # Upstream that holds the request open server-side (ms via query).
        location = /slow {
            proxy_pass http://backend/slow;
        }
    }
}
