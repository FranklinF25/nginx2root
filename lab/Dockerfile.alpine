# Source-built NGINX at a pinned release on musl (Alpine), for the
# CVE-2026-123007 lab's F2 libc-differential question: does the crash
# survive musl's memcpy and does the accounting oracle still classify?
# Same pinned-source build as ./Dockerfile, musl libc instead of glibc.
# Nothing here runs on the host (S4): build and runtime stay in Docker.
#
# TOFU pin, computed 2026-11-19 via `docker image inspect` (image already
# pulled over HTTPS from Docker Hub as alpine:3.22):
#   alpine:3.22 @ sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
FROM alpine@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f

ARG NGINX_VERSION=1.31.8
# sha256 of https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz —
# required; the build fails on mismatch (R1-unverified-upstream-artifacts).
# Source tarballs are libc-independent: identical digests to the debian
# services for the same version.
ARG NGINX_TARBALL_SHA256=

# curl is also the runtime healthcheck client; `openssl` is the CLI for the
# self-signed cert below (openssl-dev ships headers only on Alpine).
RUN apk add --no-cache \
        build-base pcre2-dev openssl-dev zlib-dev openssl curl

# Download, verify the tarball digest, then build. No unverified bytes
# from nginx.org ever reach ./configure.
RUN set -eu \
    && test -n "${NGINX_TARBALL_SHA256}" \
        || { echo "ERROR: NGINX_TARBALL_SHA256 build arg is required" >&2; exit 1; } \
    && curl -fsSL "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" -o /tmp/nginx.tar.gz \
    && printf '%s  %s\n' "${NGINX_TARBALL_SHA256}" /tmp/nginx.tar.gz | sha256sum -c - \
    && tar xzf /tmp/nginx.tar.gz -C /tmp \
    && cd "/tmp/nginx-${NGINX_VERSION}" \
    && ./configure \
        --prefix=/etc/nginx \
        --sbin-path=/usr/sbin/nginx \
        --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/dev/stderr \
        --http-log-path=/dev/stdout \
        --pid-path=/tmp/nginx.pid \
        --with-http_ssl_module \
        --with-http_v2_module \
        --with-http_stub_status_module \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/nginx*

# Self-signed lab certificate for the TLS/h2 listener
RUN mkdir -p /etc/nginx/certs \
    && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -subj "/CN=lab.nginx2root.local" \
        -keyout /etc/nginx/certs/lab.key \
        -out /etc/nginx/certs/lab.crt

# 64 MiB of servable body so response DATA can be queued against a
# zero-sized stream window.
RUN mkdir -p /var/www \
    && dd if=/dev/zero of=/var/www/big.bin bs=1M count=64 status=none

# The real nginx.conf is volume-mounted by docker-compose (h2 vs h2-off).
STOPSIGNAL SIGQUIT
EXPOSE 8080 443
CMD ["nginx", "-g", "daemon off;"]
